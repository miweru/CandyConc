# Local audit/probe artifacts. Keep real tests under src/__tests__ and e2e
# explicitly named; underscore/probe files are scratch outputs from manual UI
# audits and must not drift into release commits.
.claude/
/_*.mjs
/_*.png
/e2e/*-probe.spec.ts
/src/__tests__/_*.test.ts

